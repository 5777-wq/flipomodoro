<?xml version="1.0" encoding="utf-8"?>
<!--
  深色模式下刻意沿用同一套浅色值。
  配色锁定为暖米白主题，不提供暗色变体，
  这样系统切换深浅模式时窗口底色不变，不会出现闪白 / 闪黑。
-->
<resources>
    <color name="colorPrimary">#F0EEE6</color>
    <color name="colorPrimaryDark">#E4E1D6</color>
    <color name="colorAccent">#D97757</color>
    <color name="splashBackground">#F0EEE6</color>
</resources>
